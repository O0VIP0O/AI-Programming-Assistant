@{
    ViewData["Title"] = "Learning";
    Layout = null;
    // استلام معرف المستخدم من الكنترولر
    var userId = ViewBag.UserId ?? 0;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500&family=Cairo:wght@300;400;600;700&family=Inter:wght@300;400;600&display=swap');

        :root {
            --bg-deep: #08080a;
            --bg-card: rgba(15, 15, 20, 0.95);
            --accent: #00f2ff;
            --border-color: #3c3c3c;
            --border: rgba(255, 255, 255, 0.05);
            --text-main: #cccccc;
        }

        body {
            font-family: 'Inter', 'Cairo', sans-serif;
            background-color: var(--bg-deep);
            color: var(--text-main);
            height: 100vh;
            margin: 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .code-font {
            font-family: 'Fira Code', monospace;
        }

        .modern-nav {
            background-color: #181818 !important;
            border-bottom: 1px solid var(--border-color) !important;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 100;
        }

        .nav-box {
            background-color: #2d2d2d;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 4px 20px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .nav-link-custom {
            color: #aaa !important;
            font-size: 0.9rem;
            text-decoration: none;
            transition: color 0.2s;
        }

            .nav-link-custom:hover, .nav-link-custom.active {
                color: #fff !important;
            }

        #bg-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
        }

        .app-shell {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        /* Sidebar Styling */
        .sidebar-progress {
            width: 280px;
            background: rgba(20, 20, 25, 0.9);
            backdrop-filter: blur(15px);
            border-left: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            z-index: 10;
        }

        .sidebar-section-title {
            padding: 15px;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            color: #555;
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }

        .course-item {
            padding: 12px 15px;
            font-size: 12px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: 0.2s;
            margin: 2px 8px;
            border-radius: 6px;
        }

            .course-item.active {
                background: rgba(0, 242, 255, 0.08);
                border-right: 3px solid var(--accent);
                color: white;
            }

        .level-card {
            padding: 10px 20px;
            font-size: 11px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: 0.2s;
        }

            .level-card.locked {
                opacity: 0.25;
                cursor: not-allowed;
            }

            .level-card.active {
                background: rgba(255,255,255,0.03);
                color: var(--accent);
            }

            .level-card.completed {
                color: #4ade80;
            }

        .glass-panel {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.6);
        }

        .quiz-option {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 15px;
            cursor: pointer;
            font-size: 0.85rem;
        }

            .quiz-option.selected {
                background: rgba(0, 242, 255, 0.1);
                border-color: var(--accent);
                color: white;
            }

        .btn-action {
            background: var(--accent);
            color: black;
            font-weight: 700;
            padding: 14px;
            border-radius: 8px;
            transition: 0.3s;
        }

            .btn-action:disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

        /* Loading Overlay */
        #loadingOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1000;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .loader-spinner {
            width: 50px;
            height: 50px;
            border: 3px solid var(--accent);
            border-top-color: transparent;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            to

        {
            transform: rotate(360deg);
        }

        }
    </style>
</head>
<body>

    <div id="loadingOverlay">
        <div class="loader-spinner mb-4"></div>
        <p class="text-cyan-400 font-mono animate-pulse">جاري معالجة طلبك عبر الذكاء الاصطناعي...</p>
    </div>

    <header class="modern-nav">
        <div class="nav-box">
            <a class="nav-link-custom" href="/Home/Index">الرئيسية</a>
            <a class="nav-link-custom active" href="/Learning/Learning">التعلم</a>
            <a class="nav-link-custom" href="/Code_Explainer/Code_Explainer">شارح الكود</a>
        </div>
    </header>

    <canvas id="bg-canvas"></canvas>

    <div class="app-shell">
        <aside class="sidebar-progress">
            <div class="sidebar-section-title flex justify-between items-center">
                <span>المسارات النشطة</span>
                <button onclick="backToSetup()" class="text-gray-500 hover:text-cyan-400">
                    <i data-lucide="plus-circle" size="14"></i>
                </button>
            </div>
            <div id="activeTracksList" class="py-2"></div>

            <div id="pathProgressSection" class="hidden flex-1 flex flex-col border-t border-white/5">
                <div class="sidebar-section-title flex justify-between">
                    <span>خريطة الطريق</span>
                    <i data-lucide="map" size="12"></i>
                </div>
                <div id="levelList" class="flex-1 overflow-y-auto"></div>
            </div>

            <div id="emptySidebarHint" class="flex-1 flex flex-col items-center justify-center p-6 text-center text-gray-600">
                <i data-lucide="layers" size="32" class="mb-3 opacity-20"></i>
                <p class="text-[9px] uppercase tracking-widest">ابدأ اختيار لغة لملء الشريط</p>
            </div>
        </aside>

        <main class="main-stage flex-1 p-8 overflow-y-auto">
            <!-- Setup Step -->
            <div id="setupStep" class="max-w-xl mx-auto py-12">
                <div class="text-center mb-12">
                    <h2 class="text-3xl font-bold text-white mb-3">اختر تخصصك البرمجي</h2>
                    <p class="text-gray-400 text-sm">سيتم بناء مسار تعليمي مخصص لك باستخدام Ollama.</p>
                </div>
                <div class="glass-panel space-y-6">
                    <select id="langSelect" class="bg-black/40 border border-white/10 text-white w-full p-3 rounded-lg text-sm" onchange="checkOther(this.value)">
                        <option value="" disabled selected>-- اختر لغة البرمجة --</option>
                        <option value="C#">C# .NET</option>
                        <option value="Python">Python</option>
                        <option value="JavaScript">JavaScript</option>
                        <option value="Java">Java Core</option>
                        <option value="other">أخرى...</option>
                    </select>
                    <div id="otherInputArea" class="hidden">
                        <input type="text" id="otherLang" class="bg-black/40 border border-white/10 text-white w-full p-3 rounded-lg text-sm" placeholder="مثال: Go, Rust...">
                    </div>
                    <button onclick="initiateCourse()" class="btn-action w-full flex items-center justify-center gap-3">
                        <i data-lucide="zap" size="18"></i> بناء المسار التعليمي
                    </button>
                </div>
            </div>

            <!-- Learning Step -->
            <div id="learningStep" class="max-w-5xl mx-auto hidden">
                <div class="mb-8">
                    <h2 id="activeLevelTitle" class="text-2xl font-bold text-white">المستوى</h2>
                    <p id="coursePathInfo" class="text-[10px] text-cyan-400 font-mono mt-1 uppercase"></p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <div class="lg:col-span-7">
                        <div class="glass-panel min-h-[500px]">
                            <div id="lessonText" class="text-gray-300 text-sm leading-relaxed prose prose-invert max-w-none">
                                <!-- AI Content Here -->
                            </div>
                        </div>
                    </div>
                    <div class="lg:col-span-5">
                        <div id="quizPanel" class="glass-panel">
                            <h3 class="text-xs font-bold text-cyan-400 mb-6 flex items-center gap-2 uppercase">
                                <i data-lucide="clipboard-list" size="16"></i> امتحان المستوى
                            </h3>
                            <div id="quizContainer" class="space-y-6 max-h-[400px] overflow-y-auto pr-2"></div>
                            <div id="quizFooter" class="mt-8 pt-4 border-t border-white/5">
                                <button id="submitExamBtn" onclick="submitExam()" class="btn-action w-full text-xs">تصحيح الامتحان</button>
                                <div id="examResult" class="hidden mt-4 text-center p-3 rounded-lg text-xs font-bold"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        const USER_ID = @userId;
        let state = {
            activeLanguage: '',
            courses: {}, // { 'Python': maxUnlocked }
            currentLevel: 1,
            questions: [], // Current level questions
            userAnswers: {}
        };

        // UI Initializers
        lucide.createIcons();
        initNeuralBackground();

        window.onload = async () => {
            if (USER_ID > 0) {
                await fetchUserCourses();
            }
        };


        // 1. جلب الكورسات النشطة للمستخدم
        async function fetchUserCourses() {
            try {
                const res = await fetch('/Learning/GetUserCourses', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: USER_ID })
                });
                const data = await res.json();
                if (data.success) {
                    data.courses.forEach(c => {
                        state.courses[c.language] = c.maxUnlocked;
                    });
                    renderActiveTracks();
                    if (data.courses.length > 0) {
                        document.getElementById('emptySidebarHint').classList.add('hidden');
                    }
                }
            } catch (err) { console.error("Error fetching courses", err); }
        }

        // 2. بدء كورس جديد أو تحميل كورس موجود
        function checkOther(v) { document.getElementById('otherInputArea').classList.toggle('hidden', v !== 'other'); }

        async function initiateCourse() {
            const select = document.getElementById('langSelect').value;
            const otherText = document.getElementById('otherLang').value;
            const lang = (select === 'other') ? otherText : select;

            if (!lang) return alert("يرجى اختيار لغة");

            const maxLvl = state.courses[lang] || 1;
            await loadLevel(lang, maxLvl);
        }

        // 3. جلب محتوى المستوى من الكنترولر (Ollama)
        async function loadLevel(lang, level) {
            showLoading(true);
            try {
                const res = await fetch('/Learning/GetContent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ language: lang, level: level, userId: USER_ID })
                });
                const data = await res.json();

                if (data.success) {
                    state.activeLanguage = lang;
                    state.currentLevel = level;
                    state.courses[lang] = data.maxUnlocked;
                    state.questions = JSON.parse(data.exam);
                    state.userAnswers = {};

                    // Update UI
                    document.getElementById('setupStep').classList.add('hidden');
                    document.getElementById('learningStep').classList.remove('hidden');
                    document.getElementById('pathProgressSection').classList.remove('hidden');

                    document.getElementById('activeLevelTitle').innerText = data.title;
                    document.getElementById('coursePathInfo').innerText = `SYSTEM_PATH: ${lang} / LVL_${level}`;
                    document.getElementById('lessonText').innerHTML = data.content;

                    renderSidebarLevels();
                    renderActiveTracks();
                    renderQuiz();

                    // Reset Exam UI
                    const resultDiv = document.getElementById('examResult');
                    const btn = document.getElementById('submitExamBtn');
                    resultDiv.classList.add('hidden');

                    if (level < data.maxUnlocked) {
                        resultDiv.innerHTML = "لقد أجريت هذا الاختبار بنجاح مسبقاً.";
                        resultDiv.className = "mt-4 text-center p-3 rounded-lg bg-green-500/10 text-green-400 border border-green-500/20 block";
                        btn.classList.add('hidden');
                    } else {
                        btn.classList.remove('hidden');
                    }
                } else {
                    alert("فشل جلب المحتوى: " + data.message);
                }
            } catch (err) {
                console.error(err);
                alert("حدث خطأ أثناء التواصل مع الخادم.");
            } finally {
                showLoading(false);
            }
        }


        function renderQuiz() {
            const container = document.getElementById('quizContainer');
            container.innerHTML = state.questions.map((q, idx) => `
                <div class="pb-5 border-b border-white/5">
                    <p class="text-[11px] text-gray-400 mb-3 font-bold"><span class="text-cyan-400">س${idx+1}:</span> ${q.question}</p>
                    <div class="grid gap-2">
                        ${q.options.map((opt, i) => `
                            <div class="quiz-option q-${idx}" onclick="selectAnswer(${idx}, ${i}, this)">${opt}</div>
                        `).join('')}
                    </div>
                </div>
            `).join('');
        }

        function selectAnswer(qIdx, optIdx, el) {
            if (state.currentLevel < state.courses[state.activeLanguage]) return;
            document.querySelectorAll(`.q-${qIdx}`).forEach(o => o.classList.remove('selected'));
            el.classList.add('selected');
            state.userAnswers[qIdx] = optIdx;
        }

        async function submitExam() {
            if (Object.keys(state.userAnswers).length < state.questions.length) {
                return alert("يرجى الإجابة على جميع الأسئلة.");
            }

            let correctCount = 0;
            state.questions.forEach((q, idx) => {
                if (state.userAnswers[idx] === q.correct) correctCount++;
            });

            const resultDiv = document.getElementById('examResult');
            resultDiv.classList.remove('hidden');

            if (correctCount >= 0) { // نجاح إذا كانت الإجابات 70% فأكثر
                resultDiv.innerHTML = `نجحت! النتيجة: ${correctCount}/${state.questions.length}. جاري ترقيتك...`;
                resultDiv.className = "mt-4 text-center p-3 rounded-lg bg-green-500/10 text-green-400 border border-green-500/20";

                // تحديث قاعدة البيانات
                await updateDatabaseProgress(state.currentLevel + 1);
            } else {
                resultDiv.innerHTML = `لم تجتز الاختبار. النتيجة: ${correctCount}/${state.questions.length}. حاول مرة أخرى.`;
                resultDiv.className = "mt-4 text-center p-3 rounded-lg bg-red-500/10 text-red-400 border border-red-500/20";
            }
        }

        async function updateDatabaseProgress(newLevel) {
            try {
                const res = await fetch('/Learning/UpdateProgress', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        language: state.activeLanguage,
                        newLevel: newLevel,
                        userId: USER_ID
                    })
                });
                const data = await res.json();
                if (data.success) {
                    state.courses[state.activeLanguage] = data.newMaxUnlocked;
                    renderSidebarLevels();
                    renderActiveTracks();
                    // تحميل المستوى التالي تلقائياً بعد ثانيتين
                    setTimeout(() => loadLevel(state.activeLanguage, newLevel), 2000);
                }
            } catch (err) { console.error(err); }
        }


        function renderActiveTracks() {
            const list = document.getElementById('activeTracksList');
            list.innerHTML = Object.keys(state.courses).map(lang => `
                <div class="course-item ${state.activeLanguage === lang ? 'active' : ''}" onclick="loadLevel('${lang}', ${state.courses[lang]})">
                    <span class="flex items-center gap-2"><i data-lucide="terminal" size="12"></i> ${lang}</span>
                    <span class="text-[9px] opacity-40 font-bold">Lvl ${state.courses[lang]}</span>
                </div>
            `).join('');
            lucide.createIcons();
        }

        function renderSidebarLevels() {
            const max = state.courses[state.activeLanguage] || 1;
            const list = document.getElementById('levelList');
            let html = '';
            for (let i = 1; i <= 15; i++) {
                let cls = i > max ? 'locked' : (i === state.currentLevel ? 'active' : '');
                if (i < max) cls += ' completed';

                html += `
                    <div class="level-card ${cls}" onclick="${i <= max ? `loadLevel('${state.activeLanguage}', ${i})` : ''}">
                        <div class="w-5 h-5 rounded-full border border-current flex items-center justify-center text-[9px]">
                            ${i < max ? '✓' : i}
                        </div>
                        <span class="truncate font-bold">المستوى ${i}</span>
                    </div>
                `;
            }
            list.innerHTML = html;
        }

        function backToSetup() {
            document.getElementById('setupStep').classList.remove('hidden');
            document.getElementById('learningStep').classList.add('hidden');
        }

        function showLoading(show) {
            document.getElementById('loadingOverlay').style.display = show ? 'flex' : 'none';
        }

        function initNeuralBackground() {
            const canvas = document.getElementById('bg-canvas');
            const ctx = canvas.getContext('2d');
            let points = [];
            const init = () => {
                canvas.width = window.innerWidth; canvas.height = window.innerHeight;
                points = Array.from({length: 50}, () => ({
                    x: Math.random()*canvas.width, y: Math.random()*canvas.height,
                    vx: (Math.random()-0.5)*0.5, vy: (Math.random()-0.5)*0.5
                }));
            };
            const draw = () => {
                ctx.clearRect(0,0,canvas.width,canvas.height);
                points.forEach((p, i) => {
                    p.x += p.vx; p.y += p.vy;
                    if(p.x<0||p.x>canvas.width) p.vx*=-1; if(p.y<0||p.y>canvas.height) p.vy*=-1;
                    ctx.fillStyle = 'rgba(0,242,255,0.1)'; ctx.beginPath(); ctx.arc(p.x, p.y, 2, 0, Math.PI*2); ctx.fill();
                    for(let j=i+1; j<points.length; j++) {
                        let d = Math.hypot(p.x-points[j].x, p.y-points[j].y);
                        if(d<150) {
                            ctx.strokeStyle = `rgba(0,242,255,${0.1*(1-d/150)})`;
                            ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(points[j].x, points[j].y); ctx.stroke();
                        }
                    }
                });
                requestAnimationFrame(draw);
            };
            init(); draw(); window.onresize = init;
        }
    </script>
</body>
</html>